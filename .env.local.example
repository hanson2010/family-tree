# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# --- Settings (in production: set by cloudbuild.yaml) ---

# Origin the app is served from; the OAuth redirect URIs are this + /api/auth/callback/google and /api/auth/callback/github
NEXTAUTH_URL=http://localhost:3000

# Firestore project and service account key
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini model for importing records and finding faces in group photos
GOOGLE_AI_MODEL=gemini-3.5-flash-lite

# Optional: a stronger Gemini model for finding faces in group photos (defaults to GOOGLE_AI_MODEL)
# GOOGLE_AI_FACES_MODEL=

# Google OAuth client ID (https://console.cloud.google.com/apis/credentials); not a secret
GOOGLE_CLIENT_ID=your-google-client-id

# GitHub OAuth app client ID (https://github.com/settings/developers); not a secret
GITHUB_CLIENT_ID=your-github-client-id

# --- Secrets (in production: the family-tree-app-secrets JSON in Secret Manager) ---

# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret

# Google OAuth client secret (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth app client secret (https://github.com/settings/developers)
GITHUB_CLIENT_SECRET=your-github-client-secret

# Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_AI_API_KEY=your-gemini-api-key

# Alternatively, set the secrets as one JSON object, like production.
# When set, the secret variables above are ignored.
# APP_SECRETS={"AUTH_SECRET":"...","GOOGLE_CLIENT_SECRET":"...","GITHUB_CLIENT_SECRET":"...","GOOGLE_AI_API_KEY":"..."}
