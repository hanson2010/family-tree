# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# AUTH_SECRET is used by NextAuth v5 (preferred)
AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
# NEXTAUTH_SECRET is for backwards compatibility with v4
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# GitHub OAuth (Create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
# For local development, use service account key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google AI (Gemini) API Key
# Get from https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-gemini-api-key
# Gemini Model (default: gemini-2.5-flash-lite)
GOOGLE_AI_MODEL=gemini-2.5-flash-lite

# Production (Cloud Run) - Set via Cloud Run environment variables
# These are set automatically when deploying to Cloud Run
# NEXTAUTH_URL=https://your-domain.com
# GOOGLE_CLOUD_PROJECT=your-project-id
